# Firebase Web Client Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google OAuth 2.0 Client (ai-foundation-firebase)
VITE_GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here

# Gemini AI Service Configuration
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# LMS shared-network configuration
VITE_LMS_SITE_ID=lms
# Set to false once migrate-to-lms has been run and verified
VITE_LMS_LEGACY_READ=true

# Image uploads (imgbb)
VITE_IMGBB_API_KEY=your_imgbb_api_key_here

# Stripe Payments
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

