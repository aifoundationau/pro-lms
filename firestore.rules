rules_version = '2';

// Firestore security rules for the shared `lms` namespace.
//
// !! DO NOT DEPLOY until Firebase Authentication is wired into the app. !!
// The app currently has no real sign-in (`isLoggedIn` is local UI state only),
// so deploying these rules would block the Course Builder and Student admin.
//
// Staff are identified by a custom auth claim: { lmsStaff: true, siteId: "<site>" }
// set via the Firebase Admin SDK.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isStaff() { return signedIn() && request.auth.token.lmsStaff == true; }
    function staffSite() { return request.auth.token.siteId; }
    function ownsSite(siteId) { return isStaff() && staffSite() == siteId; }

    // ---- Courses: network-visible courses are readable by anyone in the network ----
    match /lms_courses/{courseId} {
      allow read: if resource.data.visibility == 'network' || ownsSite(resource.data.siteId);
      allow create: if ownsSite(request.resource.data.siteId);
      allow update: if ownsSite(resource.data.siteId)
                    && request.resource.data.siteId == resource.data.siteId;
      allow delete: if false; // archive instead of delete
    }

    // ---- Students: site-scoped staff only ----
    match /lms_students/{studentId} {
      allow read, delete: if ownsSite(resource.data.siteId);
      allow create: if ownsSite(request.resource.data.siteId);
      allow update: if ownsSite(resource.data.siteId)
                    && request.resource.data.siteId == resource.data.siteId;

      // Sensitive PII: never readable via network/shared queries
      match /private/{docId} {
        allow read, write: if ownsSite(get(/databases/$(database)/documents/lms_students/$(studentId)).data.siteId)
                           || (request.resource != null && ownsSite(request.resource.data.siteId));
      }
    }

    // ---- Leads: public may create (contact form), only staff may read ----
    match /lms_leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'message', 'siteId', 'source', 'createdAt'])
                    && request.resource.data.name is string && request.resource.data.name.size() <= 200
                    && request.resource.data.email is string && request.resource.data.email.size() <= 320
                    && request.resource.data.message is string && request.resource.data.message.size() <= 5000;
      allow read: if ownsSite(resource.data.siteId);
      allow update, delete: if false;
    }

    // ---- Legacy collections: read-only for staff during migration, then remove ----
    match /courses/{id} { allow read: if isStaff(); allow write: if false; }
    match /students/{id} { allow read, delete: if isStaff(); allow write: if false; }
  }
}
