{
  "name": "pro-lms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "migrate:lms": "node --env-file=.env scripts/migrate-to-lms.mjs",
    "test": "node tests/courseSpreadsheet.test.js && node tests/aiAssist.test.js && node tests/lmsFeatures.test.js && node tests/ui.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-ozedu-rules \"node tests/firestoreRules.test.js\"",
    "test:e2e": "firebase emulators:exec --only firestore,auth --project demo-ozedu-e2e \"node tests/e2e.services.test.js\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-admin": "^14.5.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
